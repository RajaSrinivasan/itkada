with "../../itklib.gpr";

project Adaimg is
   for Main use ("adaimg.adb");
   for Source_Dirs use (".");
   for Object_Dir use "../../obj/adaimg";
   for Exec_Dir use "../../bin";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-gnatwa", "-gnat2022");
   end Compiler;
end Adaimg;
