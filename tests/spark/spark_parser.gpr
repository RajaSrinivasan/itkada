project Spark_Parser is
   for Source_Dirs use ("../../examples/adaimg");
   for Source_Files use ("adaimg_command.ads", "adaimg_command.adb");
   for Object_Dir use "../../obj/spark-parser";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--mode=silver", "--level=2");
   end Prove;
end Spark_Parser;
