with "../itklib.gpr";

project Generated_Tests is
   for Main use ("generated_tests.adb");
   for Source_Dirs use ("generated");
   for Object_Dir use "../obj/generated_tests";
   for Exec_Dir use "../bin";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-gnatwa", "-gnat2022");
   end Compiler;
end Generated_Tests;
